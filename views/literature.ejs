<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Arts and Recreation - E-Library Management</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #4CAF50;
            --accent-color: #388E3C;
            --text-color: #333;
            --white: #fff;
            --light-gray: #f5f5f5;
            --medium-gray: #e0e0e0;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }
        
        body {
            background-color: var(--light-gray);
            color: var(--text-color);
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }
        
        /* Header Styles */
        header {
            padding: 20px 0;
            background-color: var(--white);
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 1px solid #eee;
        }
        
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .logo {
            font-size: 24px;
            font-weight: 700;
            color: var(--primary-color);
        }
        
        .nav-links {
            display: flex;
            gap: 30px;
        }
        
        .nav-links a {
            text-decoration: none;
            color: var(--text-color);
            font-weight: 500;
            transition: color 0.3s;
        }
        
        .nav-links a:hover {
            color: var(--primary-color);
        }
        
        .cta-button {
            background-color: var(--primary-color);
            color: var(--white);
            padding: 10px 24px;
            border-radius: 30px;
            font-weight: 600;
            text-decoration: none;
            transition: background-color 0.3s;
        }
        
        .cta-button:hover {
            background-color: var(--accent-color);
        }
        
        /* Hero Section */
        .hero {
            background-image: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url('https://source.unsplash.com/random/1200x400/?art');
            background-size: cover;
            background-position: center;
            color: var(--white);
            padding: 80px 0;
            text-align: center;
            margin-bottom: 60px;
        }
        
        .hero h2 {
            font-size: 36px;
            margin-bottom: 20px;
        }
        
        .hero p {
            font-size: 18px;
            max-width: 700px;
            margin: 0 auto 30px;
        }
        
        .btn {
            display: inline-block;
            padding: 12px 25px;
            background-color: var(--primary-color);
            color: var(--white);
            text-decoration: none;
            border-radius: 5px;
            font-weight: 500;
            transition: background-color 0.3s;
        }
        
        .btn:hover {
            background-color: var(--accent-color);
        }
        
        .section-title {
            text-align: center;
            margin-bottom: 40px;
        }
        
        .section-title h2 {
            font-size: 32px;
            position: relative;
            display: inline-block;
            padding-bottom: 10px;
        }
        
        .section-title h2:after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 50px;
            height: 3px;
            background-color: var(--primary-color);
        }

        /* Available Books Section with Scrolling */
        .books-section {
            padding: 60px 0;
            background-color: var(--white);
        }
        
        .books-carousel {
            position: relative;
            padding: 0 50px;
            margin-bottom: 40px;
        }
        
        .books-wrapper {
            display: flex;
            overflow-x: auto;
            scroll-behavior: smooth;
            scrollbar-width: none; /* Firefox */
            -ms-overflow-style: none; /* Internet Explorer and Edge */
            gap: 30px;
            padding: 20px 0;
        }
        
        .books-wrapper::-webkit-scrollbar {
            display: none; /* Chrome, Safari and Opera */
        }
        
        .book-item {
            flex: 0 0 calc(33.333% - 20px);
            min-width: 300px;
            position: relative;
            overflow: hidden;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s, box-shadow 0.3s;
        }
        
        .book-item:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2);
        }
        
        .book-item img {
            width: 100%;
            height: 250px;
            object-fit: cover;
            transition: transform 0.5s;
        }
        
        .book-item:hover img {
            transform: scale(1.05);
        }
        
        .book-info {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
            color: var(--white);
            padding: 20px;
        }
        
        .book-info h3 {
            font-size: 20px;
            margin-bottom: 5px;
        }
        
        .book-info p {
            font-size: 14px;
            opacity: 0.8;
        }
        
        .carousel-controls {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 20px;
        }
        
        .carousel-control {
            background-color: var(--primary-color);
            color: var(--white);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            transition: background-color 0.3s;
        }
        
        .carousel-control:hover {
            background-color: var(--accent-color);
        }
        
        /* Virtual Exhibition Section */
        .exhibition-section {
            padding: 60px 0;
            background-color: var(--light-gray);
        }
        
        .exhibition-container {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }
        
        .exhibition-card {
            display: flex;
            background-color: var(--white);
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }
        
        .exhibition-card:nth-child(even) {
            flex-direction: row-reverse;
        }
        
        .exhibition-image {
            flex: 1;
            min-height: 300px;
        }
        
        .exhibition-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .exhibition-content {
            flex: 1;
            padding: 30px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        
        .exhibition-content h3 {
            font-size: 24px;
            margin-bottom: 15px;
            color: var(--primary-color);
        }
        
        .exhibition-content p {
            margin-bottom: 20px;
            line-height: 1.6;
        }
        
        /* Footer Styles */
        footer {
            background-color: var(--text-color);
            color: var(--white);
            padding: 60px 0 30px;
        }
        
        .footer-content {
            display: flex;
            justify-content: space-between;
            margin-bottom: 40px;
        }
        
        .footer-column {
            flex: 1;
            margin-right: 30px;
        }
        
        .footer-column h3 {
            font-size: 20px;
            margin-bottom: 20px;
            position: relative;
        }
        
        .footer-column h3:after {
            content: "";
            display: block;
            width: 30px;
            height: 2px;
            background-color: var(--primary-color);
            margin-top: 10px;
        }
        
        .footer-column p {
            color: #aaa;
            margin-bottom: 20px;
            font-size: 14px;
        }
        
        .footer-links {
            list-style: none;
        }
        
        .footer-links li {
            margin-bottom: 10px;
        }
        
        .footer-links a {
            color: #aaa;
            text-decoration: none;
            transition: color 0.3s;
        }
        
        .footer-links a:hover {
            color: var(--white);
        }
        
        .copyright {
            text-align: center;
            padding-top: 20px;
            border-top: 1px solid #444;
            color: #aaa;
            font-size: 14px;
        }
        
        .social-icons {
            display: flex;
            gap: 15px;
        }
        
        .social-icons a {
            color: var(--white);
            font-size: 18px;
            transition: color 0.3s;
        }
        
        .social-icons a:hover {
            color: var(--primary-color);
        }
        
        /* Responsive Styles */
        @media (max-width: 992px) {
            .exhibition-card {
                flex-direction: column !important;
            }
            
            .exhibition-image {
                min-height: 250px;
            }
            
            .footer-content {
                flex-wrap: wrap;
            }
            
            .footer-column {
                flex: 0 0 calc(50% - 30px);
                margin-bottom: 30px;
            }
            
            .book-item {
                flex: 0 0 calc(50% - 20px);
                min-width: 250px;
            }
        }
        
        @media (max-width: 768px) {
            nav {
                flex-direction: column;
                gap: 15px;
            }
            
            .nav-links {
                flex-wrap: wrap;
                justify-content: center;
                gap: 15px;
            }
            
            .book-item {
                flex: 0 0 calc(100% - 20px);
                min-width: 300px;
            }
            
            .footer-column {
                flex: 0 0 100%;
            }
        }
    </style>
</head>

<body>
    <!-- Header -->
    <header>
        <div class="container">
            <nav>
                <div class="logo">E-Library</div>
                <div class="nav-links">
                    <a href="/">Home</a>
                    <a href="/books">Books</a>
                    <a href="/admin">Suggestions</a>
                    <a href="/aboutus">About</a>
                    <a href="/contactus">Contact</a>
                </div>
                <a href="/login" class="cta-button">Get Started</a>

            </nav>
        </div>
    </header>

    <section class="hero">
        <div class="container">
            <h2>Literature Collection</h2>
            <p>Discover timeless classics, modern masterpieces, poetry, and literary history from around the world.</p>
            <a href="/contactus" class="btn">Explore Collection</a>
        </div>
    </section>
    
    <!-- Available Books Section -->
    <section class="books-section">
        <div class="container">
            <div class="section-title">
                <h2>Available Books</h2>
            </div>
            <div class="books-carousel">
                <div class="books-wrapper" id="booksWrapper">
                    <div class="book-item">
                        <img src="images/lit.jpg" alt="Classic Literature">
                        <div class="book-info">
                            <h3>Classic Literature</h3>
                            <p>Explore timeless novels from Dickens, Austen, and more.</p>
                        </div>
                    </div>
                    <div class="book-item">
                        <img src="images/mf.jpg" alt="Modern Fiction">
                        <div class="book-info">
                            <h3>Modern Fiction</h3>
                            <p>Discover contemporary stories shaping the literary world.</p>
                        </div>
                    </div>
                    <div class="book-item">
                        <img src="images/pa.webp" alt="Poetry Anthology">
                        <div class="book-info">
                            <h3>Poetry Anthology</h3>
                            <p>A collection of poetry from various literary movements.</p>
                        </div>
                    </div>
                    <div class="book-item">
                        <img src="images/lc.jpg" alt="Literary Criticism">
                        <div class="book-info">
                            <h3>Literary Criticism</h3>
                            <p>Analyze and interpret great works of literature.</p>
                        </div>
                    </div>
                </div>
                <div class="carousel-controls">
                    <div class="carousel-control prev" onclick="scrollBooks('prev')">
                        <i class="fas fa-chevron-left"></i>
                    </div>
                    <div class="carousel-control next" onclick="scrollBooks('next')">
                        <i class="fas fa-chevron-right"></i>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Virtual Exhibition Section -->
    <section class="exhibition-section">
        <div class="container">
            <div class="section-title">
                <h2>Virtual Exhibitions</h2>
            </div>
            <div class="exhibition-container">
                <div class="exhibition-card">
                    <div class="exhibition-image">
                        <img src="images/sll.jpg" alt="Shakespeare's Legacy">
                    </div>
                    <div class="exhibition-content">
                        <h3>Shakespeare's Legacy</h3>
                        <p>Explore the impact of William Shakespeare on literature and theater.</p>
                        <a href="/contactus" class="btn">Visit Exhibition</a>
                    </div>
                </div>
                <div class="exhibition-card">
                    <div class="exhibition-image">
                        <img src="images/romantic_poets.jpg" alt="Romantic Poets">
                    </div>
                    <div class="exhibition-content">
                        <h3>Romantic Poets</h3>
                        <p>Dive into the works of Keats, Byron, and Wordsworth.</p>
                        <a href="/contactuss" class="btn">Visit Exhibition</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-column">
                    <h3>E-Library</h3>
                    <p>Your digital book hub providing access to thousands of books anytime, anywhere.</p>
                    <div class="social-icons">
                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>
                <div class="footer-column">
                    <h3>Quick Links</h3>
                    <ul class="footer-links">
                        <li><a href="/">Home</a></li>
                        <li><a href="/aboutus">About Us</a></li>
                        <li><a href="/books">Books</a></li>
                        <li><a href="/admin">Suggestions</a></li>
                        <li><a href="/contactus">Contact</a></li>
                    </ul>
                </div>
                <div class="footer-column">
                    <h3>Support</h3>
                    <ul class="footer-links">
                        <li><a href="#">FAQ</a></li>
                        <li><a href="#">Help Center</a></li>
                        <li><a href="#">Privacy Policy</a></li>
                        <li><a href="#">Terms of Service</a></li>
                    </ul>
                </div>
                <div class="footer-column">
                    <h3>Contact</h3>
                    <p><i class="fas fa-map-marker-alt"></i> 123 Library St, Booktown</p>
                    <p><i class="fas fa-phone"></i> +1 (555) 123-4567</p>
                    <p><i class="fas fa-envelope"></i> info@elibrary.com</p>
                </div>
            </div>
            <div class="copyright">
                <p>© 2023 E-Library Management. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script>
        // JavaScript for the books carousel
        function scrollBooks(direction) {
            const container = document.getElementById('booksWrapper');
            const scrollAmount = <%= scrollValue %>; // Assuming 'scrollValue' is passed from the server
    
            if (direction === 'next') {
                container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
            } else {
                container.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
            }
        }
    </script>
</body>
</html>