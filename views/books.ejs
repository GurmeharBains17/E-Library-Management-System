        /* Explore by Category */
        .explore-heading {
            font-family: 'Pacifico', cursive;
            font-size: 32px;
            font-weight: 700;
            color: black;
            letter-spacing: 2px;
            margin-bottom: 25px;
        }

        /* Add Emoji after Explore by Category */
        .explore-heading::after {
            content: " 📚";
        }

        /* Upcoming Books Section - Moved Down */
        .upcoming-section {
            width: 20%;
            text-align: left;
            padding: 20px;
            position: absolute;
            left: 3%;
            top: 65%; /* Adjusted lower to match 'Explore by Category' */
            transform: translateY(-50%);
        }

        /* Updated Font Style for Upcoming Books */
        .upcoming-title {
            font-size: 28px;
            font-weight: 800;
            font-family: 'Playfair Display', serif;
            color: #222;
        }

        /* Clock Animation - Clicking Effect */
        .clock-emoji {
            display: inline-block;
            font-size: 28px;
            animation: clock-tick 1s infinite alternate ease-in-out;
        }

        @keyframes clock-tick {
            0% { transform: rotate(-5deg) translateY(0px); }
            50% { transform: rotate(5deg) translateY(-3px); }
            100% { transform: rotate(-5deg) translateY(0px); }
        }

        .upcoming-list {
            list-style-type: none;
            padding: 0;
        }

        .upcoming-list li {
            font-size: 18px;
            font-weight: 500;
            margin-bottom: 30px;
        }

