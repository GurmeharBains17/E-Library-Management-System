/* Books Grid */
/* Books Grid */
.books-grid-container {
    display: flex;
    justify-content: center;
    width: 85%;
    margin: auto;
    margin-top: 20px; /* Adjusted to move slightly down */
    margin-left: 10%;
}

.books-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    width: 70%;
}

.category {
    text-align: center;
    padding: 10px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}



        /* Book Hover Effects */
        .category:hover {
            transform: scale(1.05);
            box-shadow: 5px 5px 15px rgba(0, 0, 0, 0.2);
        }

        .category a {
            text-decoration: none;
            color: inherit;
        }

        .category img {
            width: 100%;
            max-width: 250px;
            height: 350px;
            border-radius: 12px;
            object-fit: cover;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            box-shadow: 5px 5px 15px rgba(0, 0, 0, 0.2);
        }

        /* Hover Effects for Images */
        .category img:hover {
            transform: rotate(3deg) scale(1.08);
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.5);
        }
