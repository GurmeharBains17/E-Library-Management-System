}/* See More Button */
.see-more {
    background-color: #f0f0f0;
}

/* Modal Styles */
.modal {
    display: none;
    position: fixed;
    z-index: 10;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
    background: white;
    padding: 20px;
    width: 60%;
    margin: 10% auto;
    border-radius: 10px;
    position: relative;
}

.close {
    position: absolute;
    top: 10px;
    right: 20px;
    font-size: 20px;
    cursor: pointer;
}

/* 🔍 Search Bar */
.search-container {
    position: relative;
    width: 100%;
    max-width: 600px;
    margin: auto;
}

/* 🌟 Search Input */
.search-input {
    width: 100%;
    padding: 12px 15px;
    font-size: 18px;
    border: 2px solid #007bff;
    border-radius: 8px;
    outline: none;
    transition: 0.3s ease-in-out;
}

/* 🔍 Search Button */
.search-button {
    position: absolute;
    right: 15px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    font-size: 22px;
    cursor: pointer;
    color: #007bff;
    transition: 0.3s ease;
}

.search-button:hover {
    color: #ff5722;
}

/* 🎭 Search Options Box */
.search-options {
    display: none;
    position: absolute;
    background: white;
    box-shadow: 0px 5px 15px rgba(0, 0, 0, 0.2);
    padding: 15px;
    border-radius: 8px;
    top: 100%;
    left: 0;
    width: 100%;
    z-index: 10;
}

/* 🏷 Search Options Title */
.search-options p {
    margin: 0;
    font-size: 16px;
    font-weight: bold;
    color: #333;
}

/* 🛠 Search Option Buttons */
.search-option, .advanced-search {
    padding: 8px 12px;
    border: 2px solid #007bff;
    background: white;
    cursor: pointer;
    border-radius: 6px;
    font-size: 14px;
    transition: 0.3s ease-in-out;
}

.search-option:hover, .advanced-search:hover {
    background: #007bff;
    color: white;
}

/* ✅ Active Search Option */
.search-option.active {
    background: #007bff;
    color: white;
}

/* 🔻 OR TRY Text */
.or-try {
    padding: 0 10px;
    color: #888;
    font-size: 14px;
}

/* ❌ Close Button */
.close-button {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 18px;
    color: red;
    float: right;
    transition: 0.3s ease-in-out;
}

.close-button:hover {
    color: darkred;
}
